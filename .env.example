# Скопируйте этот файл в .env и заполните значениями

# --- Supabase (настоящая регистрация) ---
# 1. Зарегистрируйтесь на supabase.com и создайте проект
# 2. Выполните scripts/supabase-setup.sql в SQL Editor проекта
# 3. Скопируйте значения из Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- NOWPayments (крипто-оплата) ---
# 1. Зарегистрируйтесь на nowpayments.io → Account → API keys
# 2. Создайте ключ (только для создания инвойсов достаточно)
# Ключ хранится ТОЛЬКО в Supabase Secrets (см. README), здесь не нужен!

# --- ИИ-тренёр (edge function ai-coach) ---
# Ключ провайдера хранится ТОЛЬКО в Supabase Secrets, здесь не нужен:
#   supabase secrets set AI_PROVIDER_KEY=sk-...
# Необязательные секреты (по умолчанию OpenAI, модель gpt-4o-mini):
#   AI_PROVIDER_URL=https://api.openai.com/v1   # или DeepSeek/OpenRouter
#   AI_MODEL=gpt-4o-mini
#   AI_COACH_FREE_LIMIT=5                        # вопросов в день без Premium
#   AI_COACH_PREMIUM_LIMIT=50                    # вопросов в день с Premium
# Перед включением примените supabase/migrations/20260821000000_ai_coach.sql
